{
  "manifest_version": 3,
  "name": "Game Night Access Adapter",
  "version": "0.1.0",
  "description": "Remap camera, voice, and phone inputs to LibreCorsa keyboard controls.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:18765/*",
    "http://localhost:18765/*",
    "https://khazp.github.io/librecorsa/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Game Night Access Adapter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://khazp.github.io/librecorsa/*"
      ],
      "js": ["content/inject.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page-hook.js"],
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://khazp.github.io/librecorsa/*"
      ]
    }
  ]
}
